{
	"$schema": "https://json.schemastore.org/package",
	"private": true,
	"name": "pylib",
	"version": "0.1.0",
	"license": "GPL-2.0-or-later",
	"author": "n9gc",
	"description": "和 Python 各种库的对接",
	"type": "module",
	"exports": {
		".": "./lib/index.ts",
		"./manage": "./manage.ts",
		"./*": "./lib/*.ts"
	},
	"scripts": {
		"prepare": "pnpm run \"/^prepare:(i18n|uv|ts-to-zod)/\" && pnpm run prepare:py-type",
		"prepare:i18n": "typesafe-i18n --no-watch",
		"prepare:uv": "uv sync",
		"prepare:ts-to-zod": "make-dir dist && ts-to-zod --all --skipValidation && ts-to-zod --all && tsx manage.ts metaType",
		"prepare:py-type": "tsx manage.ts outSchema",

		"dev:i18n": "typesafe-i18n"
	},
	"devDependencies": {
		"pylib": "workspace:^",

		"ts-to-zod": "latest",

		"@types/node": "latest"
	},
	"dependencies": {
		"lib": "workspace:^",
		"tape-i18n": "workspace:^",

		"ts-morph": "latest",
		"zod": "latest",
		"typesafe-i18n": "latest"
	}
}
