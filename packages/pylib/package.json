{
	"$schema": "https://json.schemastore.org/package",
	"private": true,
	"name": "pylib",
	"version": "0.1.0",
	"license": "GPL-2.0-or-later",
	"author": "n9gc",
	"description": "和 Python 各种库的对接",
	"type": "module",
	"exports": {
		"./*": "./*"
	},
	"scripts": {
		"prepare": "pnpm prepare:i18n && pnpm prepare:pyenv",
		"prepare:i18n": "typesafe-i18n --no-watch",
		"prepare:pyenv": "tsx ./manage.ts prepare",

		"dev:i18n": "typesafe-i18n"
	},
	"devDependencies": {
		"pylib": "workspace:^",

		"@types/node": "latest"
	},
	"dependencies": {
		"lib": "workspace:^",
		"tape-i18n": "workspace:^",

		"zod": "latest",
		"typesafe-i18n": "latest"
	}
}
