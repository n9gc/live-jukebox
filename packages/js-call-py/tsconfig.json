{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../tsbase.json",
	"compilerOptions": {
		"types": ["node"],

		"rewriteRelativeImportExtensions": true,
		"emitDeclarationOnly": false,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "dist"
	},
	"files": [
		"ts-to-zod.config.mjs",
		"dist/lib-caller-types.ts",
		"dist/lib-config-types.ts"
	],
	"include": ["**/*.ts"]
}
