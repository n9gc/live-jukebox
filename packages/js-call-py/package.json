{
	"$schema": "https://json.schemastore.org/package",
	"name": "js-call-py",
	"version": "0.1.0",
	"license": "MIT",
	"author": "n9gc",
	"description": "export python function to js typesafely through rpc based on child_process and stdio",
	"keywords": [
		"typesafe",
		"python",
		"rpc",
		"nodejs"
	],
	"type": "module",
	"exports": {
		"./config": "./lib/config/index.ts",
		"./caller": "./lib/caller/index.ts",
		".": "./lib/index.ts"
	},
	"bugs": {
		"url": "https://github.com/n9gc/js-call-py/issues"
	},
	"homepage": "https://github.com/n9gc/js-call-py#readme",
	"repository": {
		"url": "git+https://github.com/n9gc/js-call-py",
		"type": "git"
	},
	"scripts": {
		"prepare": "pnpm run /^prepare:.*/",
		"prepare:ts-to-zod": "make-dir dist && ts-to-zod --all --skipValidation && ts-to-zod --all && node manage.ts metaType",

		"build:tsc": "tsc --outDir .",

		"clear:tsc": "rimraf -g -- **/*.{d.ts,js} tsconfig.tsbuildinfo",

		"prepublishOnly": "pnpm run /^build:.*/",
		"postpublish": "pnpm run /^clear:.*/"
	},
	"files": [
		"*",
		"!tsconfig.json",
		"!**/*.ts",
		"**/*.d.ts",
		"!*.swp",
		"!pnpm-lock.yaml"
	],
	"devDependencies": {
		"ts-to-zod": "latest",
		"@types/node": "latest"
	},
	"dependencies": {
		"ts-morph": "^28.0.0",
		"@utilize/zod": "^0.4.1",
		"cosmiconfig": "^9.0.2",
		"lite-emit": "^4.0.0",
		"json-schema-typed": "^8.0.2",
		"ajv": "^8.20.0",
		"@oclif/core": "^4.11.4",
		"zod": "^4.0.0"
	},
	"bin": {
		"js-call-py": "./bin/run.js"
	}
}
